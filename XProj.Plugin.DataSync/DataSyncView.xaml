<UserControl x:Class="XProj.Plugin.DataSync.DataSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             Background="Transparent"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" Background="{DynamicResource SelectedBrush}" CornerRadius="12"><mi:MaterialIcon Kind="CloudSyncOutline" Width="21" Height="21" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="数据同步" Style="{DynamicResource PageTitle}" FontWeight="SemiBold" /><TextBlock Text="通过 WebDAV 同步配置文件（不含备份），按变更传输" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" /></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{DynamicResource ActionChip}" ToolTip="连接测试" Click="TestConnection_Click"><mi:MaterialIcon Kind="LanConnect" Width="16" Height="16" /></Button><Button Style="{StaticResource PrimaryButton}" Click="Sync_Click"><StackPanel Orientation="Horizontal"><mi:MaterialIcon Kind="Sync" Width="16" Height="16" Margin="0,0,7,0" /><TextBlock Text="立即同步" Foreground="White" FontWeight="SemiBold" /></StackPanel></Button></StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="280" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" MinWidth="380" /></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{DynamicResource CardBorder}" Padding="17"><StackPanel>
                        <TextBlock Text="WebDAV 连接" Style="{DynamicResource SectionTitle}" Margin="0,0,0,14" />
                        <TextBlock Text="地址" Style="{DynamicResource FieldLabel}" /><TextBox x:Name="EndpointBox" Tag="https://dav.example.com/remote.php/dav/files/user" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="用户名" Style="{DynamicResource FieldLabel}" /><TextBox x:Name="UsernameBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="口令" Style="{DynamicResource FieldLabel}" /><PasswordBox x:Name="PasswordBox" /></StackPanel></Grid>
                        <TextBlock Text="远程目录" Style="{DynamicResource FieldLabel}" Margin="0,12,0,0" /><TextBox x:Name="RemoteDirectoryBox" Tag="xproj" />
                    </StackPanel></Border>
                    <Border Style="{DynamicResource CardBorder}" Padding="17" Margin="0,12,0,0"><StackPanel>
                        <TextBlock Text="同步策略" Style="{DynamicResource SectionTitle}" Margin="0,0,0,14" /><TextBlock Text="冲突处理" Style="{DynamicResource FieldLabel}" /><ComboBox x:Name="ConflictBox" /><CheckBox x:Name="AutoSyncCheckBox" Content="启用自动同步" Margin="0,13,0,0" Checked="AutoSync_Changed" Unchecked="AutoSync_Changed" /><Grid Margin="0,10,0,0"><TextBlock Text="同步间隔（分钟）" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="IntervalBox" Width="68" HorizontalAlignment="Right" Text="30" TextChanged="Interval_TextChanged" /></Grid>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Style="{DynamicResource CardBorder}" Padding="17">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="同步记录" Style="{DynamicResource SectionTitle}" /><TextBlock x:Name="LastSyncText" Text="尚未同步" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="1" Style="{DynamicResource ActionChip}" HorizontalAlignment="Right" ToolTip="清空记录" Click="ClearLog_Click"><mi:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16" /></Button></Grid><Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" Margin="0,14,0,0" /><Border Grid.Row="2" Background="{DynamicResource LogBackgroundBrush}" CornerRadius="11" Margin="0,14,0,0" ClipToBounds="True"><ListBox x:Name="LogListBox" ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource LogTextBrush}" FontFamily="{DynamicResource LogFontFamily}" FontSize="{DynamicResource LogFontSize}" Padding="12,10" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Border><TextBlock x:Name="StatusText" Grid.Row="3" Text="填写连接信息后即可同步配置文件（自动排除备份）。" Foreground="{DynamicResource MutedTextBrush}" Margin="2,12,2,0" TextWrapping="Wrap" /></Grid>
            </Border>
            <Border x:Name="BusyOverlay" Grid.ColumnSpan="3" Background="#88101418" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="BusyText" Text="正在同步..." FontSize="15" HorizontalAlignment="Center" /><ProgressBar Width="180" Height="4" IsIndeterminate="True" Margin="0,14,0,0" /><Button Content="停止" Width="90" Margin="0,14,0,0" Click="Cancel_Click" /></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
