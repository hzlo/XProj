<Window x:Class="ProjectManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjectManager.Wpf.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="XProj"
        Icon="Assets/icon.ico"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ProjectListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="13" Padding="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupOnlyMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:GroupFilterKind.Group}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GroupOnlySeparator" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:GroupFilterKind.Group}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:GroupTreeItem}" ItemsSource="{Binding Children}">
            <Border Background="Transparent" Margin="2,1">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Opened="GroupContextMenu_Opened">
                        <MenuItem Header="新建分组" Click="AddGroup_Click">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:GroupFilterKind.Group}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="新建子分组" Click="AddGroup_Click">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:GroupFilterKind.Group}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="新建同级分组" Click="AddSiblingGroup_Click">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:GroupFilterKind.Group}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator Style="{StaticResource GroupOnlySeparator}" />
                        <MenuItem Header="编辑分组" Click="EditGroup_Click" Style="{StaticResource GroupOnlyMenuItem}" />
                        <MenuItem Header="删除分组" Click="DeleteGroup_Click" Style="{StaticResource GroupOnlyMenuItem}"
                                  Foreground="{DynamicResource DangerBrush}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Border>
        </HierarchicalDataTemplate>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ClickMode="Press"
                                              Focusable="False"
                                              Width="18"
                                              Height="30">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}">
                                                <Path x:Name="Chevron" Data="M 1 1 L 5 5 L 1 9" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="HeaderSurface" Grid.Column="1" Background="Transparent" CornerRadius="9" Padding="7,6" Margin="0,1">
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
                                </Border>
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost" Margin="17,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SelectedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionChip" TargetType="Button" BasedOn="{StaticResource IconButton}" />

        <Style x:Key="RunningStatusChip" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource TitleStatusBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackdropBrush}">
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-280,-160,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#161A84FF" Offset="0" />
                        <GradientStop Color="#081A84FF" Offset="0.48" />
                        <GradientStop Color="#001A84FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#10FF375F" Offset="0" />
                        <GradientStop Color="#05FF375F" Offset="0.5" />
                        <GradientStop Color="#00FF375F" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Margin="14,0,8,0">
                <Image Width="26" Height="26" Source="{DynamicResource AppLogo}" Stretch="Uniform" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="36,0,0,0">
                    <TextBlock Text="XProj" FontSize="13" />
                    <TextBlock Text="本地工作台" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="10,1,0,0" />
                </StackPanel>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="RunningStatusButton"
                                  Style="{StaticResource RunningStatusChip}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                  AutomationProperties.Name="查看运行中的命令"
                                  MouseEnter="RunningStatus_MouseEnter"
                                  MouseLeave="RunningStatus_MouseLeave"
                                  Click="RunningStatus_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11">
                                <Run Text="运行中 " /><Run Text="{Binding RunningCount, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="RunningStatusPopup"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                           PlacementTarget="{Binding ElementName=RunningStatusButton}"
                           Placement="Bottom"
                           VerticalOffset="7"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="True"
                           Closed="RunningStatusPopup_Closed">
                        <Border x:Name="RunningPopoverSurface"
                                Width="340"
                                MaxHeight="420"
                                Background="{DynamicResource PopupBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                MouseEnter="RunningPopover_MouseEnter"
                                MouseLeave="RunningPopover_MouseLeave">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="2,0,2,11">
                                    <TextBlock Text="运行中的命令" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding RunningCount}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" MaxHeight="310" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding RunningCommands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource InsetPanelBrush}"
                                                        BorderBrush="{DynamicResource SoftBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="11,9"
                                                        Margin="0,0,0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0" />
                                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                            <TextBlock Text="{Binding ProjectName}"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CommandName}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CommandText}"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="10"
                                                                       Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Grid.Row="1"
                                           Text="当前没有正在运行的命令"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,24,0,26">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunningCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                    <mi:MaterialIcon Kind="PinOutline" Width="12" Height="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,5,0" />
                                    <TextBlock Text="单击顶部状态可驻留" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="设置" Click="Settings_Click">
                        <mi:MaterialIcon Kind="CogOutline" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="MinimizeWindow_Click">
                        <mi:MaterialIcon Kind="WindowMinimize" Width="14" Height="14" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" ToolTip="最大化" Click="MaximizeWindow_Click">
                        <mi:MaterialIcon Kind="WindowMaximize" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Foreground="{DynamicResource MutedTextBrush}" ToolTip="关闭窗口" Click="CloseWindow_Click">
                        <mi:MaterialIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="12,4,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" MinWidth="210" />
                    <ColumnDefinition Width="326" MinWidth="290" />
                    <ColumnDefinition Width="*" MinWidth="500" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Background="{DynamicResource SidebarBrush}" Margin="0,0,6,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,4,2,14">
                            <StackPanel>
                                <TextBlock Text="工作空间" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="按分组浏览全部项目" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="新建分组" Click="AddGroup_Click">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <TreeView x:Name="GroupTree" Grid.Row="1" ItemsSource="{Binding GroupItems}" SelectedItemChanged="GroupTree_SelectedItemChanged" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Background="{DynamicResource InputBrush}" Margin="6" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="3,3,0,13">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="项目" Style="{StaticResource SectionTitle}" />
                                <Border Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Projects.Count}" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="添加项目" Click="AddProject_Click">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <TextBox Height="40" Padding="36,9,12,9" Tag="搜索项目、目录或命令" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}"
                                             Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ProjectListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                             Opened="ProjectContextMenu_Opened">
                                                    <MenuItem Header="编辑项目" Click="EditProject_Click" />
                                                    <Separator />
                                                    <MenuItem Header="打开目录" Click="OpenFolder_Click" />
                                                    <MenuItem Header="打开终端" Click="OpenTerminal_Click" />
                                                    <MenuItem Header="使用 VS Code 打开" Click="OpenEditor_Click" />
                                                    <Separator />
                                                    <MenuItem Header="删除项目" Click="DeleteProject_Click" Foreground="{DynamicResource DangerBrush}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,52,0" />
                                                    <Border HorizontalAlignment="Right" Background="{DynamicResource InsetPanelBrush}" CornerRadius="7" Padding="6,1">
                                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="10"><Run Text="{Binding Commands.Count, Mode=OneWay}" /><Run Text=" 项" /></TextBlock>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding WorkingDirectory}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding WorkingDirectory}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="52" Height="52" Background="{DynamicResource SelectedBrush}" CornerRadius="17" HorizontalAlignment="Center">
                                    <mi:MaterialIcon Kind="Plus" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="还没有项目" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,5" />
                                <TextBlock Text="添加目录后即可集中运行命令" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="2" Margin="6,0,0,0">
                    <Border Padding="32">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="选择一个项目" FontSize="22" Margin="0,0,0,7" HorizontalAlignment="Center" />
                            <TextBlock Text="命令、状态与实时输出会出现在这里" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasSelectedProject}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasSelectedProject}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="230" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="2,0,20,0">
                                    <TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedProject.WorkingDirectory}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,6,0,0" ToolTip="{Binding SelectedProject.WorkingDirectory}" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionChip}" ToolTip="编辑项目" Click="EditProject_Click">
                                        <mi:MaterialIcon Kind="PencilOutline" Width="15" Height="15" />
                                    </Button>
                                    <Button Style="{StaticResource ActionChip}" ToolTip="打开目录" Click="OpenFolder_Click">
                                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource ActionChip}" ToolTip="打开终端" Click="OpenTerminal_Click">
                                        <mi:MaterialIcon Kind="ConsoleLine" Width="16" Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource ActionChip}" Foreground="{DynamicResource DangerBrush}" ToolTip="删除项目" Click="DeleteProject_Click">
                                        <mi:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                                    </Button>
                                </WrapPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,16,0,-7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="项目命令" Style="{StaticResource SectionLabel}" Margin="0,9,14,0" VerticalAlignment="Top" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Commands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CommandButton}"
                                                         Click="CommandButton_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                                     Opened="CommandContextMenu_Opened">
                                                            <MenuItem Header="运行" Click="RunCommand_Click">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="停止" Click="StopCommand_Click">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="重启" Click="RestartCommand_Click">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="编辑命令" Click="EditCommand_Click" />
                                                            <MenuItem Header="清空日志" Click="ClearLog_Click" />
                                                            <Separator />
                                                            <MenuItem Header="删除命令" Click="DeleteCommand_Click" Foreground="{DynamicResource DangerBrush}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="实时日志" Style="{StaticResource SectionTitle}" />
                                        <Border Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="8,2" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding SelectedCommand.Name, TargetNullValue=未选择命令}" Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ActionChip}" Foreground="{DynamicResource WarningBrush}" ToolTip="停止命令"
                                                IsEnabled="{Binding SelectedCommand.CanStop, FallbackValue=False, TargetNullValue=False}" Click="StopCommand_Click">
                                            <mi:MaterialIcon Kind="StopCircleOutline" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource ActionChip}" ToolTip="重启命令"
                                                IsEnabled="{Binding HasSelectedCommand}" Click="RestartCommand_Click">
                                            <mi:MaterialIcon Kind="Restart" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource ActionChip}" ToolTip="清空日志"
                                                IsEnabled="{Binding HasSelectedCommand}" Click="ClearLog_Click">
                                            <mi:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="LogTextBox" Grid.Row="1"
                                         IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                         FontFamily="{Binding LogFontFamily}" FontSize="{Binding LogFontSize}"
                                         FontWeight="{Binding LogFontWeight}" FontStyle="{Binding LogFontStyle}"
                                         Foreground="{DynamicResource LogTextBrush}" Background="{DynamicResource LogBackgroundBrush}"
                                         BorderThickness="0,1,0,0" Padding="16,13" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="17,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
                <TextBlock Text="本地进程工作区 · 数据仅保存在此设备" Foreground="{DynamicResource FooterTextBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Window>
