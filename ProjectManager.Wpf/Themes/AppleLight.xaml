<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ImageBrush x:Key="AppLogoBrush" ImageSource="/XProj;component/Assets/logo_light.png" Stretch="Uniform" />
    <SolidColorBrush x:Key="WindowBrush" Color="#FFDCDDE1" />
    <SolidColorBrush x:Key="PanelBrush" Color="#EFE4E5E8" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#FFE9EAEC" />
    <SolidColorBrush x:Key="PanelSolidBrush" Color="#FFE2E4E7" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FFD5D7DB" />
    <SolidColorBrush x:Key="PressedBrush" Color="#FFC9CDD2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFBEC2C9" />
    <SolidColorBrush x:Key="SoftBorderBrush" Color="#FFCED1D6" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF51545A" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF7A7E87" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF006EDB" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#FF007AFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD70015" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF248A3D" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#18248A3D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC65D00" />
    <SolidColorBrush x:Key="InsetPanelBrush" Color="#FFE4E5E8" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFEAECEE" />
    <SolidColorBrush x:Key="InputFocusedBrush" Color="#FFEEEFF1" />
    <SolidColorBrush x:Key="ReadOnlyBrush" Color="#FFD7D9DD" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#FF9FA5AF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1F007AFF" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#66007AFF" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#99D5D7DB" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FCE9EAEC" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#F5DCDDE1" />
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#66DFE1E3" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#667A7E87" />
    <SolidColorBrush x:Key="TooltipBrush" Color="#FCE9EAEC" />
    <SolidColorBrush x:Key="ContextMenuBrush" Color="#FCE9EAEC" />
