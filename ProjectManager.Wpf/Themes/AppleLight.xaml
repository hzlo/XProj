    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFD70015" />
    <SolidColorBrush x:Key="ValidationTextBrush" Color="#FFB00020" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FFE4E5E8" />
    <SolidColorBrush x:Key="LogTextBrush" Color="#FF1D3321" />
    <SolidColorBrush x:Key="TitleStatusBrush" Color="#EFE9EAEC" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#EFE9EAEC" />
    <SolidColorBrush x:Key="FooterTextBrush" Color="#FF7A7E87" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#55007AFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#33A8CFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF1D1D1F" />
    <LinearGradientBrush x:Key="AppBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE3E5E8" Offset="0" />
        <GradientStop Color="#FFD8DBDF" Offset="0.55" />
        <GradientStop Color="#FFE4DFE2" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
