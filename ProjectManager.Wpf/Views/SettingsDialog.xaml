<Window x:Class="ProjectManager.Wpf.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="设置"
        Width="760"
        Height="690"
        MinWidth="680"
        MinHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="18" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="OptionToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorPickerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource HoverBorderBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Dot" Property="Opacity" Value="0.7" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="22,0,11,0">
                <TextBlock Text="设置" FontSize="15" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" IsCancel="True">
                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,8,26,6">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="2,0,0,10" />
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="颜色模式" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Text="切换后会同步更新窗口、标题栏和 Logo" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="主题颜色" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBlock Text="输入 #RRGGBB；卡片、输入框和次级文字会自动匹配"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,14" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="背景色" Style="{StaticResource SectionLabel}" />
                                <TextBlock Grid.Column="2" Text="前景色" Style="{StaticResource SectionLabel}" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="3" Text="预览" Style="{StaticResource SectionLabel}" Margin="8,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="浅色" VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="LightBackgroundTextBox" Tag="#RRGGBB" Padding="12,9,42,9" TextChanged="ThemeColorTextChanged" />
                                    <Button x:Name="LightBackgroundPickerButton" Style="{StaticResource ColorPickerButton}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                            Click="PickLightBackground_Click" ToolTip="打开颜色选择器" />
                                </Grid>
                                <Grid Grid.Column="2" Margin="8,0,0,0">
                                    <TextBox x:Name="LightForegroundTextBox" Tag="#RRGGBB" Padding="12,9,42,9" TextChanged="ThemeColorTextChanged" />
                                    <Button x:Name="LightForegroundPickerButton" Style="{StaticResource ColorPickerButton}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                            Click="PickLightForeground_Click" ToolTip="打开颜色选择器" />
                                </Grid>
                                <Border x:Name="LightColorPreview" Grid.Column="3" Height="38" CornerRadius="9" Margin="8,0,0,0"
                                        BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="LightColorPreviewText" Text="示例文字" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="4" Content="恢复" MinWidth="58" Margin="8,2,0,2" Padding="9,5" Click="ResetLightColors_Click" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="深色" VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="DarkBackgroundTextBox" Tag="#RRGGBB" Padding="12,9,42,9" TextChanged="ThemeColorTextChanged" />
                                    <Button x:Name="DarkBackgroundPickerButton" Style="{StaticResource ColorPickerButton}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                            Click="PickDarkBackground_Click" ToolTip="打开颜色选择器" />
                                </Grid>
                                <Grid Grid.Column="2" Margin="8,0,0,0">
                                    <TextBox x:Name="DarkForegroundTextBox" Tag="#RRGGBB" Padding="12,9,42,9" TextChanged="ThemeColorTextChanged" />
                                    <Button x:Name="DarkForegroundPickerButton" Style="{StaticResource ColorPickerButton}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                            Click="PickDarkForeground_Click" ToolTip="打开颜色选择器" />
                                </Grid>
                                <Border x:Name="DarkColorPreview" Grid.Column="3" Height="38" CornerRadius="9" Margin="8,0,0,0"
                                        BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="DarkColorPreviewText" Text="示例文字" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="4" Content="恢复" MinWidth="58" Margin="8,2,0,2" Padding="9,5" Click="ResetDarkColors_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="应用行为" Style="{StaticResource SectionTitle}" Margin="2,22,0,10" />
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="关闭窗口时" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Text="完全退出会停止所有正在运行的命令" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="CloseBehaviorComboBox" Grid.Column="1" />
                        </Grid>
                    </Border>

                    <TextBlock Text="实时日志" Style="{StaticResource SectionTitle}" Margin="2,22,0,10" />
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="界面保留行数" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Text="仅显示最新日志，较小的行数占用更少资源" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="LogVisibleLineCountComboBox" Grid.Column="1" />
                        </Grid>
                    </Border>

                    <TextBlock Text="字体" Style="{StaticResource SectionTitle}" Margin="2,22,0,10" />
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="界面字体" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="UiFontComboBox" DisplayMemberPath="Source" SelectionChanged="FontSelectionChanged" />
                                <ComboBox x:Name="UiFontSizeComboBox" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="FontSelectionChanged" />
                            </Grid>
                            <Border Background="{DynamicResource InsetPanelBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1"
                                    CornerRadius="11" Padding="14,10" Margin="0,11,0,18">
                                <TextBlock x:Name="UiFontPreview" Text="XProj 项目工作台 · 清晰、从容、专注" TextTrimming="CharacterEllipsis" />
                            </Border>

                            <TextBlock Text="实时日志字体" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="LogFontComboBox" DisplayMemberPath="Source" SelectionChanged="FontSelectionChanged" />
                                <ComboBox x:Name="LogFontSizeComboBox" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="FontSelectionChanged" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                <ToggleButton x:Name="LogBoldToggle" Content="粗体" Style="{StaticResource OptionToggle}" Checked="FontSelectionChanged" Unchecked="FontSelectionChanged" />
                                <ToggleButton x:Name="LogItalicToggle" Content="斜体" Style="{StaticResource OptionToggle}" Checked="FontSelectionChanged" Unchecked="FontSelectionChanged" />
                            </StackPanel>
                            <Border Background="{DynamicResource LogBackgroundBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1"
                                    CornerRadius="11" Padding="14,10">
                                <TextBlock x:Name="LogFontPreview" Text="[12:08:36] 服务已启动 · Listening on http://localhost:5000" Foreground="{DynamicResource LogTextBrush}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="2,22,0,10" />
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="XProj 更新" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="检查更新" MinWidth="96" Click="CheckUpdates_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Text="配置文件" Style="{StaticResource SectionTitle}" Margin="2,22,0,10" />
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="导入或导出全部配置" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Text="包含分组、项目、命令和当前设置" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="导入" MinWidth="78" Click="Import_Click" />
                                <Button Content="导出" MinWidth="78" Click="Export_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="OperationStatusText" Foreground="{DynamicResource SuccessBrush}" Margin="4,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="26,16,26,22">
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" MinWidth="86" IsCancel="True" />
                    <Button Content="保存设置" MinWidth="108" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
