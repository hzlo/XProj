<Window x:Class="ProjectManager.Wpf.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="选择颜色" Width="430" Height="600" MinWidth="430" MinHeight="600"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="Transparent">
    <Window.Resources>
        <Style x:Key="ColorDotButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource HoverBorderBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Dot" Property="Opacity" Value="0.7" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="230" /><RowDefinition Height="34" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="选择颜色" FontSize="15" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <Button HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}" Click="Cancel_Click">
                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Border x:Name="SaturationSurface" CornerRadius="12" ClipToBounds="True" MouseLeftButtonDown="SaturationSurface_MouseLeftButtonDown" MouseMove="SaturationSurface_MouseMove">
                    <Grid>
                        <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0" /><GradientStop Color="Transparent" Offset="1" /></LinearGradientBrush></Grid.Background></Grid>
                        <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Transparent" Offset="0" /><GradientStop Color="#FF000000" Offset="1" /></LinearGradientBrush></Grid.Background></Grid>
                    </Grid>
                </Border>
                <Ellipse x:Name="SaturationThumb" Width="18" Height="18" Stroke="White" StrokeThickness="2" Fill="Transparent"
                         HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
            </Grid>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Border x:Name="HueSurface" Height="18" CornerRadius="9" ClipToBounds="True"
                        MouseLeftButtonDown="HueSurface_MouseLeftButtonDown" MouseMove="HueSurface_MouseMove">
                    <Border.Background><LinearGradientBrush><GradientStop Color="#FFFF0000" Offset="0" /><GradientStop Color="#FFFFFF00" Offset="0.17" /><GradientStop Color="#FF00FF00" Offset="0.33" /><GradientStop Color="#FF00FFFF" Offset="0.5" /><GradientStop Color="#FF0000FF" Offset="0.67" /><GradientStop Color="#FFFF00FF" Offset="0.83" /><GradientStop Color="#FFFF0000" Offset="1" /></LinearGradientBrush></Border.Background>
                </Border>
                <Ellipse x:Name="HueThumb" Width="14" Height="26" Fill="Transparent" Stroke="White" StrokeThickness="2"
                         HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource InsetPanelBrush}" CornerRadius="10" Height="58" Margin="0,0,6,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="HEX" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" /><TextBlock x:Name="HexValueText" Text="#000000" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel></Border>
                <Border Grid.Column="1" Background="{DynamicResource InsetPanelBrush}" CornerRadius="10" Margin="3,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="RGB" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" /><TextBlock x:Name="RgbValueText" Text="0, 0, 0" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel></Border>
                <Border Grid.Column="2" Background="{DynamicResource InsetPanelBrush}" CornerRadius="10" Margin="6,0,0,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="预览" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" /><Ellipse x:Name="ColorPreview" Width="22" Height="22" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBox x:Name="RedTextBox" Tag="R" Margin="0,0,4,0" TextChanged="RgbTextChanged" />
                <TextBox x:Name="GreenTextBox" Grid.Column="1" Tag="G" Margin="2,0" TextChanged="RgbTextChanged" />
                <TextBox x:Name="BlueTextBox" Grid.Column="2" Tag="B" Margin="4,0,0,0" TextChanged="RgbTextChanged" />
            </Grid>
            <WrapPanel Grid.Row="5" Margin="0,16,0,0" HorizontalAlignment="Left">
                <TextBlock Text="常用色" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Tag="#C0C8E4" Style="{StaticResource ColorDotButton}" Click="PresetColor_Click" Background="#FFC0C8E4" ToolTip="蓝灰" />
                <Button Tag="#DCDDE1" Style="{StaticResource ColorDotButton}" Click="PresetColor_Click" Background="#FFDCDDE1" ToolTip="柔灰" />
                <Button Tag="#A6ADC8" Style="{StaticResource ColorDotButton}" Click="PresetColor_Click" Background="#FFA6ADC8" ToolTip="雾蓝" />
                <Button Tag="#D7BDE2" Style="{StaticResource ColorDotButton}" Click="PresetColor_Click" Background="#FFD7BDE2" ToolTip="淡紫" />
                <Button Tag="#B8D8C0" Style="{StaticResource ColorDotButton}" Click="PresetColor_Click" Background="#FFB8D8C0" ToolTip="薄荷" />
            </WrapPanel>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" MinWidth="86" Click="Cancel_Click" />
                <Button Content="使用此颜色" MinWidth="112" Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
