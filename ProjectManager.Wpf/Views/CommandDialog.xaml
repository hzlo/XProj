<Window x:Class="ProjectManager.Wpf.Views.CommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="编辑命令"
        Width="680"
        Height="360"
        MinWidth="560"
        MinHeight="320"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,10,0">
                <TextBlock Text="编辑项目命令" VerticalAlignment="Center" />
                <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" IsCancel="True" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="24,8,24,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameTextBox" Tag="例如：启动服务" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="命令" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CommandTextBox" Grid.Row="1" Tag="例如：java -jar app.jar"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="24,18,24,22">
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" MinWidth="86" IsCancel="True" />
                    <Button Content="保存命令" MinWidth="104" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
