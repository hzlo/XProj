<Window x:Class="ProjectManager.Wpf.Views.ProjectDiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="扫描项目"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DiscoveryItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{DynamicResource InsetPanelBrush}"
                                BorderBrush="{DynamicResource SoftBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="11,9">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,10,0">
                <TextBlock Text="扫描项目" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}" IsCancel="True"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="26,12,26,14">
                <StackPanel>
                    <TextBlock Text="发现可管理的本地项目" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding RootDirectory}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootDirectory}" />
                </StackPanel>
                <TextBlock Text="{Binding Choices.Count, StringFormat=发现 {0} 个候选项目}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="26,0" Padding="14">
                <ListBox ItemsSource="{Binding Choices}" ItemContainerStyle="{StaticResource DiscoveryItem}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Project.WorkingDirectory}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.WorkingDirectory}" />
                                    <TextBlock Text="{Binding CommandSummary}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="3" Margin="26,18,26,22">
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" MinWidth="86" IsCancel="True" />
                    <Button Content="添加选中项目" MinWidth="126" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
