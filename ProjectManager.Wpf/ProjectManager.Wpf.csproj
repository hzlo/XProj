<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>XProj</AssemblyName>
    <RootNamespace>ProjectManager.Wpf</RootNamespace>
    <AssemblyTitle>XProj</AssemblyTitle>
    <Description>XProj</Description>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.6.0</Version>
    <Product>XProj</Product>
    <Authors>hzlo</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo_dark.png" />
    <Resource Include="Assets\logo_light.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Material.Icons.WPF" Version="3.0.2" />
  </ItemGroup>

</Project>
