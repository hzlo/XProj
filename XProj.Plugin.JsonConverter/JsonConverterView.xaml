<UserControl x:Class="XProj.Plugin.JsonConverter.JsonConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="Transparent"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="31,6,10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,4,0" />
        </Style>
        <Style x:Key="EditorTabTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=Foreground}" />
            <Setter Property="FontWeight" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=FontWeight}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EditorTabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,4,4,3" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Border x:Name="SelectionIndicator"
                                        Height="2"
                                        Margin="9,0"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource AccentStrongBrush}"
                                        CornerRadius="1"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelSolidBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorTabsControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          CanContentScroll="False"
                                          Margin="{TemplateBinding Padding}">
                                <TabPanel IsItemsHost="True" />
                            </ScrollViewer>
                            <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />
                            <ContentPresenter Grid.Row="2" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="22,18,22,20" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 顶栏 -->
        <Grid Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" Background="{DynamicResource SelectedBrush}" CornerRadius="12">
                    <mi:MaterialIcon Kind="CodeJson" Width="21" Height="21" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="JSON 工具" Style="{DynamicResource PageTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="格式化、校验、树形预览与 JSONPath 查询（Ctrl+Enter 格式化）" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Click="NewTab_Click" ToolTip="新建标签（空文档）">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="Plus" Width="15" Height="15" Margin="0,0,5,0" />
                        <TextBlock Text="新标签" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OpenFile_Click" ToolTip="打开 .json / .jsonl / .txt，可多选，每个文件一个标签">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="FileImportOutline" Width="15" Height="15" Margin="0,0,5,0" />
                        <TextBlock Text="打开" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="SaveFile_Click" ToolTip="保存结果（结果为空则保存输入）">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,5,0" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource ActionChip}" ToolTip="复制结果" Click="CopyResult_Click">
                    <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Grid>
        <!-- 主卡片 -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <TabControl x:Name="EditorTabs" Grid.Row="0" Style="{StaticResource EditorTabsControl}" Padding="8,5,8,5" SelectionChanged="EditorTabs_SelectionChanged" />
                <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />
                <!-- 编辑区 -->
                <Grid Grid.Row="2" Margin="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>
                    <!-- 输入 -->
                    <Border Style="{DynamicResource InsetCardBorder}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <Grid Margin="14,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="输入 JSON" Style="{DynamicResource SectionTitle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="InputStatsText" Grid.Column="1" Text="0 字符" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource ActionChip}" Width="28" Height="28" ToolTip="粘贴剪贴板" Click="PasteInput_Click">
                                        <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                    </Button>
                                    <Button Style="{DynamicResource ActionChip}" Width="28" Height="28" ToolTip="清空输入" Click="ClearInput_Click">
                                        <mi:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />
                            <Border x:Name="InputErrorBar" Grid.Row="2" Background="#33FF453A" BorderBrush="#55FF453A" BorderThickness="0,0,0,1" Padding="12,7" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="InputErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource ToolButton}" Padding="8,3" Margin="8,0,0,0" Content="定位" Click="LocateError_Click" />
                                </Grid>
                            </Border>
                            <avalon:TextEditor x:Name="InputEditor" Grid.Row="3" BorderThickness="0" Background="Transparent" Padding="12,10" FontFamily="{DynamicResource LogFontFamily}" FontSize="{DynamicResource LogFontSize}" ShowLineNumbers="True" AllowDrop="True" />
                            <Grid Grid.Row="4" Margin="14,0">
                                <TextBlock x:Name="InputCaretText" Text="1:1" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="InputDocInfoText" Text="" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
                    <!-- 右侧：结果 / 树 / 查询 -->
                    <Border Grid.Column="2" Style="{DynamicResource InsetCardBorder}" Padding="0" ClipToBounds="True">
                        <TabControl x:Name="RightTabs" Background="Transparent" BorderThickness="0" Padding="0">
                            <TabItem Header="处理结果">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="14,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="处理结果" Style="{DynamicResource SectionTitle}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ResultStatsText" Grid.Column="1" Text="空" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource ActionChip}" Width="28" Height="28" ToolTip="复制结果" Click="CopyResult_Click">
                                                <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                            </Button>
                                            <Button Style="{DynamicResource ActionChip}" Width="28" Height="28" ToolTip="结果替换输入" Click="ReplaceInput_Click">
                                                <mi:MaterialIcon Kind="ArrowDownBoldBoxOutline" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />
                                    <avalon:TextEditor x:Name="ResultEditor" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="12,10" FontFamily="{DynamicResource LogFontFamily}" FontSize="{DynamicResource LogFontSize}" ShowLineNumbers="True" IsReadOnly="True" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="树形预览">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="12,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Height="30">
                                            <TextBox x:Name="TreeSearchBox" Style="{StaticResource SearchBox}" Tag="搜索属性名或值" TextChanged="TreeSearchBox_TextChanged" />
                                            <mi:MaterialIcon Kind="Magnify" Width="13" Height="13" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button Style="{StaticResource ToolButton}" Padding="8,4" Content="展开" Click="ExpandTree_Click" />
                                            <Button Style="{StaticResource ToolButton}" Padding="8,4" Content="折叠" Click="CollapseTree_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />
                                    <TreeView x:Name="JsonTreeView" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="8" FontFamily="{DynamicResource LogFontFamily}">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Text="{Binding Preview, StringFormat='  {0}'}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                        <TreeView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="复制值" Click="CopyTreeValue_Click" />
                                                <MenuItem Header="复制 JSONPath" Click="CopyTreePath_Click" />
                                            </ContextMenu>
                                        </TreeView.ContextMenu>
                                    </TreeView>
                                </Grid>
                            </TabItem>
                            <TabItem Header="JSONPath 查询">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="12,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="QueryBox" Tag="$.store.book[0].title（Enter 运行，支持 *、..、切片、多索引）" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown" />
                                        <Button Grid.Column="1" Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" Padding="12,6" Click="RunQuery_Click" ToolTip="运行查询（Enter）">
                                            <StackPanel Orientation="Horizontal">
                                                <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Margin="0,0,5,0" />
                                                <TextBlock Text="查询" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />
                                    <avalon:TextEditor x:Name="QueryResultEditor" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="12,10" FontFamily="{DynamicResource LogFontFamily}" FontSize="{DynamicResource LogFontSize}" ShowLineNumbers="True" IsReadOnly="True" />
                                    <TextBlock x:Name="QueryStatusText" Grid.Row="3" Margin="14,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Text="输入 JSONPath 后回车，结果命中数会显示在这里" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
                <!-- 选项条 -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8,14,2">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="缩进" Style="{StaticResource GroupLabel}" Margin="0,0,4,0" />
                    <ComboBox x:Name="IndentBox" Width="110" SelectionChanged="Options_Changed" ToolTip="格式化缩进">
                        <ComboBoxItem Content="2 空格" Tag="2" IsSelected="True" />
                        <ComboBoxItem Content="4 空格" Tag="4" />
                        <ComboBoxItem Content="Tab" Tag="tab" />
                    </ComboBox>
                    <CheckBox x:Name="SortDescendingCheck" Content="降序" Margin="12,0,0,0" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" ToolTip="字段排序方向" />
                    <CheckBox x:Name="CaseSensitiveCheck" Content="大小写敏感" Margin="10,0,0,0" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" />
                    <CheckBox x:Name="AllowCommentsCheck" Content="允许注释" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" />
                    <CheckBox x:Name="AllowTrailingCommasCheck" Content="允许尾逗号" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" />
                    <CheckBox x:Name="AutoFormatPasteCheck" Content="粘贴自动格式化" Margin="10,0,0,0" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" ToolTip="关闭后粘贴不再强制改写（推荐关闭）" />
                    <CheckBox x:Name="LiveValidateCheck" Content="实时校验" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" />
                    <CheckBox x:Name="WordWrapCheck" Content="自动换行" Margin="10,0,0,0" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" />
                    </WrapPanel>
                </Border>
                <!-- 操作条 -->
                <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="12,6">
                        <TextBlock Text="JSON" Style="{StaticResource GroupLabel}" />
                        <Button Style="{DynamicResource PrimaryButton}" Click="Format_Click" ToolTip="格式化（Ctrl+Enter）">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="FormatIndentIncrease" Width="15" Height="15" Margin="0,0,5,0" />
                                <TextBlock Text="格式化" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="Compact_Click" ToolTip="压缩为单行">压缩</Button>
                        <Button Style="{StaticResource ToolButton}" Click="Sort_Click" ToolTip="按选项条的升/降序与大小写规则排序">字段排序</Button>
                        <Button Style="{StaticResource ToolButton}" Click="Expand_Click" ToolTip="把字符串里的内嵌 JSON 展开为对象">展开内嵌</Button>
                        <Button Style="{StaticResource ToolButton}" Click="Validate_Click" ToolTip="校验并定位错误行列">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="CheckCircleOutline" Width="15" Height="15" Margin="0,0,5,0" />
                                <TextBlock Text="校验" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="{DynamicResource SoftBorderBrush}" Margin="8,4" />
                        <TextBlock Text="文本" Style="{StaticResource GroupLabel}" />
                        <Button Style="{StaticResource ToolButton}" Click="Escape_Click">转义</Button>
                        <Button Style="{StaticResource ToolButton}" Click="Unescape_Click">去转义</Button>
                        <Button Style="{StaticResource ToolButton}" Click="UnicodeDecode_Click">Unicode 解码</Button>
                        <Button Style="{StaticResource ToolButton}" Click="UnicodeEncode_Click">Unicode 编码</Button>
                        <Border Width="1" Background="{DynamicResource SoftBorderBrush}" Margin="8,4" />
                        <TextBlock Text="JSONL" Style="{StaticResource GroupLabel}" />
                        <Button Style="{StaticResource ToolButton}" Click="JsonLinesToArray_Click" ToolTip="每行一个 JSON → 数组">JSONL→数组</Button>
                        <Button Style="{StaticResource ToolButton}" Click="ArrayToJsonLines_Click" ToolTip="数组 → 每行一个 JSON">数组→JSONL</Button>
                        <Border Width="1" Background="{DynamicResource SoftBorderBrush}" Margin="8,4" />
                        <Button Style="{StaticResource ToolButton}" Click="ReplaceInput_Click" ToolTip="把处理结果写回输入框">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="ArrowDownBoldBoxOutline" Width="15" Height="15" Margin="0,0,5,0" />
                                <TextBlock Text="结果→输入" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="Cancel_Click" x:Name="CancelButton" Visibility="Collapsed" ToolTip="取消正在运行的操作">取消</Button>
                    </StackPanel>
                </ScrollViewer>
                <!-- 状态条 -->
                <Grid Grid.Row="5" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OperationStatusText" Text="就绪" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="120" Height="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
