<UserControl x:Class="XProj.Plugin.Wsl.WslView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="2,2,2,14">
            <StackPanel>
                <TextBlock Text="WSL" Style="{DynamicResource PageTitle}" />
                <TextBlock x:Name="AvailabilityText" Text="尚未读取发行版" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="启动发行版" MinWidth="96" IsEnabled="{Binding CanStart}" ToolTip="启动当前选中的发行版" Click="StartWsl_Click" />
                <Button Content="停止发行版" MinWidth="96" Style="{DynamicResource DangerButton}" IsEnabled="{Binding CanStop}" ToolTip="终止当前发行版中的所有进程" Click="StopWsl_Click" />
                <Button Style="{DynamicResource ActionChip}" Margin="8,0,0,0" ToolTip="刷新发行版" Click="Refresh_Click">
                    <mi:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource CardBorder}" Background="{DynamicResource SidebarBrush}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,4,10">
                        <TextBlock Text="发行版" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DistributionCountText" Text="" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="DistributionList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="DistributionList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                <Grid Margin="8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Version, StringFormat=WSL {0}}" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding StatusText, StringFormat= · {0}}" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center" Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="默认" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="2,10,2,0">
                        <Button Content="设为默认" Height="30" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSetDefault}" Click="SetDefault_Click" />
                        <Button Content="导出备份..." Height="30" HorizontalAlignment="Stretch" Margin="0,6,0,0" IsEnabled="{Binding CanManage}" Click="Export_Click" />
                        <Button Content="导入备份..." Height="30" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="Import_Click" />
                        <Button Content="卸载..." Height="30" HorizontalAlignment="Stretch" Margin="0,6,0,0" Foreground="{DynamicResource DangerBrush}" IsEnabled="{Binding CanManage}" Click="Unregister_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="{Binding ElementName=DistributionList, Path=SelectedItem.Name, TargetNullValue=选择发行版}" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource ActionChip}" ToolTip="清空输出" Click="ClearOutput_Click">
                                <mi:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16" />
                            </Button>
                            <Button Style="{DynamicResource ActionChip}" Margin="6,0,0,0" ToolTip="在终端打开" IsEnabled="{Binding HasSelectedDistribution}" Click="OpenTerminal_Click">
                                <mi:MaterialIcon Kind="ConsoleLine" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource LogBackgroundBrush}" CornerRadius="11" Margin="0,12,0,0" ClipToBounds="True">
                        <ListBox x:Name="OutputListBox" ItemsSource="{Binding OutputLines}" Background="Transparent" Foreground="{DynamicResource LogTextBrush}" BorderThickness="0"
                                 FontFamily="{DynamicResource LogFontFamily}" FontSize="{DynamicResource LogFontSize}" Padding="12,10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CommandTextBox" Height="36" Padding="10,8" Tag="向当前发行版发送命令" IsEnabled="{Binding CanRunCommand}" KeyDown="CommandTextBox_KeyDown" />
                        <Button Grid.Column="1" Style="{DynamicResource ActionChip}" Margin="8,0,0,0" ToolTip="发送命令" IsEnabled="{Binding CanRunCommand}" Click="RunCommand_Click">
                            <mi:MaterialIcon Kind="Play" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" Margin="2,10,2,0">
                        <TextBlock x:Name="CommandStatusText" Text="未启动" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{DynamicResource ActionChip}" Foreground="{DynamicResource DangerBrush}" IsEnabled="{Binding IsCommandRunning}" ToolTip="终止当前命令并重启会话" Click="StopCommand_Click">
                            <mi:MaterialIcon Kind="Stop" Width="15" Height="15" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource DangerTextBrush}" Margin="2,12,2,0" TextWrapping="Wrap" />

        <Border x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="3" Margin="-20" Background="#88101418" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding BusyText, FallbackValue=正在处理...}" FontSize="15" HorizontalAlignment="Center" />
                <Button Content="取消" MinWidth="96" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="{Binding HasCancellableOperation, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CancelManagement_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
