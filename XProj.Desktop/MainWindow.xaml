<Window x:Class="ProjectManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjectManager.Wpf.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="XProj"
        Icon="Assets/icon.ico"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBrush}"
        Loaded="Window_Loaded"
        IsVisibleChanged="Window_IsVisibleChanged"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="31,8,10,8" />
            <Setter Property="Background" Value="{DynamicResource InsetPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ActionChip" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style x:Key="SidebarToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="CommandItem" TargetType="Border">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="MaxWidth" Value="180" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunningStatusChip" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource TitleStatusBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunPlanSidebarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceGroupOnlyMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:WorkspaceTreeItemKind.Group}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="WorkspaceProjectOnlyMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:WorkspaceTreeItemKind.Project}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="8" Padding="5,3" Margin="0,1"
                                    MouseLeftButtonUp="WorkspaceItemHeader_Click">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SelectedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:WorkspaceTreeItem}" ItemsSource="{Binding Children}">
            <Border Background="Transparent" Margin="1,1">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="WorkspaceContextMenu_Opened">
                        <MenuItem Header="新建分组" Click="AddGroup_Click" Style="{StaticResource WorkspaceGroupOnlyMenuItem}" />
                        <MenuItem Header="新建子分组" Click="AddGroup_Click" Style="{StaticResource WorkspaceGroupOnlyMenuItem}" />
                        <MenuItem Header="新建同级分组" Click="AddSiblingGroup_Click" Style="{StaticResource WorkspaceGroupOnlyMenuItem}" />
                        <MenuItem Header="编辑分组" Click="EditGroup_Click" Style="{StaticResource WorkspaceGroupOnlyMenuItem}" />
                        <MenuItem Header="编辑项目" Click="EditProject_Click" Style="{StaticResource WorkspaceProjectOnlyMenuItem}" />
                        <MenuItem Header="打开目录" Click="OpenFolder_Click" Style="{StaticResource WorkspaceProjectOnlyMenuItem}" />
                        <MenuItem Header="打开终端" Click="OpenTerminal_Click" Style="{StaticResource WorkspaceProjectOnlyMenuItem}" />
                        <MenuItem Header="使用 VS Code 打开" Click="OpenEditor_Click" Style="{StaticResource WorkspaceProjectOnlyMenuItem}" />
                        <Separator />
                        <MenuItem Header="删除" Click="DeleteWorkspaceItem_Click" Foreground="{DynamicResource DangerBrush}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource BorderBrush}" Margin="5,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:WorkspaceTreeItemKind.Project}"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding HasRunningCommands}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <mi:MaterialIcon Grid.Column="0" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"><mi:MaterialIcon.Style><Style TargetType="mi:MaterialIcon"><Setter Property="Visibility" Value="Visible" /><Setter Property="Kind" Value="FolderOutline" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:WorkspaceTreeItemKind.All}"><Setter Property="Kind" Value="FolderMultipleOutline" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:WorkspaceTreeItemKind.Project}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></mi:MaterialIcon.Style></mi:MaterialIcon>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Grid Grid.Column="2" Margin="8,0,3,0">
                        <TextBlock Text="{Binding ProjectCount}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:WorkspaceTreeItemKind.All}"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:WorkspaceTreeItemKind.Ungrouped}"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:WorkspaceTreeItemKind.Group}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <TextBlock Text="{Binding RuntimeBadge}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRunningCommands}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="14,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="24" Height="24" Background="{DynamicResource AppLogoBrush}" /><TextBlock Text="XProj" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
                <ToggleButton x:Name="RunningStatusButton" Style="{StaticResource RunningStatusChip}" Width="145" Height="29" HorizontalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="查看运行中的命令" MouseEnter="RunningStatus_MouseEnter" MouseLeave="RunningStatus_MouseLeave" Click="RunningStatus_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="运行中 " /><Run Text="{Binding RunningCount, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" /></TextBlock></StackPanel></ToggleButton>
                <Popup x:Name="RunningStatusPopup" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" PlacementTarget="{Binding ElementName=RunningStatusButton}" Placement="Bottom" VerticalOffset="7" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True" Closed="RunningStatusPopup_Closed"><Border x:Name="RunningPopoverSurface" Width="340" MaxHeight="420" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" MouseEnter="RunningPopover_MouseEnter" MouseLeave="RunningPopover_MouseLeave"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Margin="2,0,2,11"><TextBlock Text="运行中的命令" Style="{StaticResource SectionTitle}" /><Button HorizontalAlignment="Right" Style="{StaticResource DangerButton}" Width="28" Height="28" MinWidth="28" Padding="0" IsEnabled="{Binding HasRunningCommands}" ToolTip="停止当前所有项目的运行命令" Click="StopAllCommands_Click"><mi:MaterialIcon Kind="StopCircleOutline" Width="15" Height="15" /></Button></Grid><ScrollViewer Grid.Row="1" MaxHeight="310" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding RunningCommands}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource InsetPanelBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding ProjectDisplayName}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" /><Grid Grid.Row="1" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding CommandName}" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Style="{StaticResource CommandActionButton}" ToolTip="终止此命令" Click="StopRunningCommand_Click"><mi:MaterialIcon Kind="Stop" Width="12" Height="12" /></Button></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Grid.Row="1" Text="当前没有正在运行的命令" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,24,0,26"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding RunningCount, Mode=OneWay}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Row="2" Text="点击状态可查看运行中的命令" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" /></Grid></Border></Popup>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="MinimizeWindow_Click"><mi:MaterialIcon Kind="WindowMinimize" Width="14" Height="14" /></Button><Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" ToolTip="最大化" Click="MaximizeWindow_Click"><mi:MaterialIcon Kind="WindowMaximize" Width="14" Height="14" /></Button><Button Style="{StaticResource TitleBarButton}" ToolTip="关闭窗口" Click="CloseWindow_Click"><mi:MaterialIcon Kind="Close" Width="15" Height="15" /></Button></StackPanel>
            </Grid>

            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="270" MinWidth="240" /><ColumnDefinition Width="*" MinWidth="480" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,0,1,0"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Top" Margin="8,10,8,0"><Button x:Name="ProjectNavigationButton" Style="{StaticResource RailButton}" Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource AccentBrush}" ToolTip="项目" Click="ProjectNavigation_Click"><mi:MaterialIcon Kind="FolderMultipleOutline" Width="19" Height="19" /></Button><StackPanel x:Name="PluginTopNavigation" Visibility="Collapsed"><Button x:Name="NotesNavigationButton" Style="{StaticResource RailButton}" ToolTip="备忘录" Click="NotesNavigation_Click"><mi:MaterialIcon Kind="NoteTextOutline" Width="19" Height="19" /></Button><Button x:Name="WslNavigationButton" Style="{StaticResource RailButton}" ToolTip="WSL" Click="WslNavigation_Click"><mi:MaterialIcon Kind="Linux" Width="19" Height="19" /></Button><Button x:Name="PluginManagementNavigationButton" Style="{StaticResource RailButton}" ToolTip="插件管理" Click="PluginManagementNavigation_Click"><mi:MaterialIcon Kind="PuzzleOutline" Width="19" Height="19" /></Button></StackPanel></StackPanel><Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Margin="8,0,8,10" ToolTip="设置" Click="Settings_Click"><mi:MaterialIcon Kind="CogOutline" Width="19" Height="19" /></Button></DockPanel></Border>
                <Grid x:Name="ProjectPage" Grid.Column="1" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="240" /><ColumnDefinition Width="*" MinWidth="480" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,0,1,0" Padding="12,14,10,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Height="38" Margin="3,0,2,11"><TextBlock Text="工作空间" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SidebarToolButton}" Foreground="{DynamicResource AccentBrush}" ToolTip="新建分组" Click="AddGroup_Click"><mi:MaterialIcon Kind="Plus" Width="16" Height="16" /></Button></Grid><Grid Grid.Row="1"><TextBox x:Name="WorkspaceSearchBox" Style="{StaticResource CompactSearchBox}" Tag="搜索项目、目录或命令" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" /></Grid><TreeView x:Name="GroupTree" Grid.Row="2" Margin="0,9,0,0" FocusVisualStyle="{x:Null}" ItemsSource="{Binding WorkspaceItems}" AllowDrop="True" PreviewMouseLeftButtonDown="SortableItem_PreviewMouseLeftButtonDown" PreviewMouseMove="SortableItem_PreviewMouseMove" Drop="SortableItem_Drop" SelectedItemChanged="GroupTree_SelectedItemChanged" /><Border Grid.Row="3" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,1,0,0" Padding="3,12,2,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Height="30"><TextBlock Text="运行方案" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SidebarToolButton}" ToolTip="管理运行方案" Click="RunPlans_Click"><mi:MaterialIcon Kind="CogOutline" Width="14" Height="14" /></Button></Grid><ScrollViewer Grid.Row="1" MaxHeight="190" Margin="0,8,0,0"><ItemsControl ItemsSource="{Binding RunPlans}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource RunPlanSidebarButton}" ToolTip="{Binding Name}" Click="RunPlanSidebar_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Commands.Count, StringFormat={}{0} 条命令}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" /></StackPanel><Border Grid.Column="1" Width="27" Height="27" Background="{DynamicResource SelectedBrush}" CornerRadius="8" Margin="8,0,0,0"><mi:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border></Grid></Border>
                    <Grid Grid.Column="1" Margin="14,14,14,12"><Border Padding="28"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><mi:MaterialIcon Kind="FolderMultipleOutline" Width="30" Height="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" /><TextBlock Text="选择一个项目" Margin="0,13,0,5" HorizontalAlignment="Center" /><TextBlock Text="命令、状态与实时输出会出现在这里" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" /></StackPanel><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardBorder}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedProject}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                        <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedProject}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="77" /><RowDefinition Height="*" MinHeight="230" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="2,0,14,0"><TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SelectedProject.WorkingDirectory}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProject.WorkingDirectory}" /></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource ActionChip}" ToolTip="编辑项目" Click="EditProject_Click"><mi:MaterialIcon Kind="PencilOutline" Width="15" Height="15" /></Button><Button Style="{StaticResource ActionChip}" ToolTip="打开目录" Click="OpenFolder_Click"><mi:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" /></Button><Button Style="{StaticResource ActionChip}" ToolTip="打开终端" Click="OpenTerminal_Click"><mi:MaterialIcon Kind="ConsoleLine" Width="15" Height="15" /></Button><Button Style="{StaticResource ActionChip}" ToolTip="使用 VS Code 打开" Click="OpenEditor_Click"><mi:MaterialIcon Kind="CodeBrackets" Width="15" Height="15" /></Button><Button Style="{StaticResource ActionChip}" Foreground="{DynamicResource DangerBrush}" ToolTip="删除项目" Click="DeleteProject_Click"><mi:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" /></Button></WrapPanel></Grid></Border>
                            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,11" Padding="8,6" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,14,0"><TextBlock Text="命令" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" /><TextBlock Text="{Binding Commands.Count, Mode=OneWay, StringFormat= · {0}}" Style="{StaticResource SectionLabel}" Margin="4,0,0,0" VerticalAlignment="Center" /></StackPanel><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"><ItemsControl x:Name="CommandItemsControl" ItemsSource="{Binding Commands}" AllowDrop="True" PreviewMouseLeftButtonDown="SortableItem_PreviewMouseLeftButtonDown" PreviewMouseMove="SortableItem_PreviewMouseMove" Drop="SortableItem_Drop"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CommandItem}" MouseLeftButtonUp="CommandCard_Click"><Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="CommandContextMenu_Opened"><MenuItem Header="运行" Click="RunCommand_Click" /><MenuItem Header="停止" Click="StopCommand_Click" /><MenuItem Header="重启" Click="RestartCommand_Click" /><Separator /><MenuItem Header="编辑命令" Click="EditCommand_Click" /><MenuItem Header="清空日志" Click="ClearLog_Click" /><Separator /><MenuItem Header="删除命令" Click="DeleteCommand_Click" Foreground="{DynamicResource DangerBrush}" /></ContextMenu></Border.ContextMenu><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><mi:MaterialIcon Width="14" Height="14" VerticalAlignment="Center"><mi:MaterialIcon.Style><Style TargetType="mi:MaterialIcon"><Setter Property="Kind" Value="Play" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Kind" Value="ProgressClock" /><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></mi:MaterialIcon.Style></mi:MaterialIcon><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center" Margin="6,0,0,0" /><Button Grid.Column="2" Style="{StaticResource CommandActionButton}" ToolTip="终止此命令" Click="CommandCardAction_Click"><mi:MaterialIcon Kind="Stop" Width="10" Height="10" /></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
                            <Border Grid.Row="2" Style="{StaticResource CardBorder}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="52" /></Grid.RowDefinitions><Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="178" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="实时日志" Style="{StaticResource SectionTitle}" /><Border Background="{DynamicResource SelectedBrush}" CornerRadius="7" Padding="8,2" Margin="9,0,0,0"><TextBlock Text="{Binding SelectedCommand.Name, TargetNullValue=未选择命令}" Foreground="{DynamicResource AccentBrush}" /></Border></StackPanel><Grid Grid.Column="1" Height="34" Margin="13,0,0,0"><TextBox Style="{StaticResource CompactSearchBox}" Tag="搜索日志" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" /><mi:MaterialIcon Kind="Magnify" Width="13" Height="13" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" /></Grid><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ActionChip}" Foreground="{DynamicResource WarningBrush}" ToolTip="停止命令" IsEnabled="{Binding SelectedCommand.CanStop, FallbackValue=False, TargetNullValue=False}" Click="StopCommand_Click"><mi:MaterialIcon Kind="StopCircleOutline" Width="16" Height="16" /></Button><Button Style="{StaticResource ActionChip}" ToolTip="重启命令" IsEnabled="{Binding HasSelectedCommand}" Click="RestartCommand_Click"><mi:MaterialIcon Kind="Restart" Width="16" Height="16" /></Button><Button Style="{StaticResource ActionChip}" ToolTip="清空日志" IsEnabled="{Binding HasSelectedCommand}" Click="ClearLog_Click"><mi:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16" /></Button></StackPanel></Grid><Grid Grid.Row="1"><ListBox x:Name="LogListBox" ItemsSource="{Binding DisplayedLogLines}" SelectionMode="Extended" FontFamily="{Binding LogFontFamily}" FontSize="{Binding LogFontSize}" FontStyle="{Binding LogFontStyle}" Foreground="{DynamicResource LogTextBrush}" Background="{DynamicResource LogBackgroundBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,1,0,0" Padding="15,12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewKeyDown="LogListBox_PreviewKeyDown"><ListBox.ContextMenu><ContextMenu><MenuItem Header="复制所选行" Click="CopySelectedLogLines_Click" /><MenuItem Header="复制全部日志" Click="CopyAllLogLines_Click" /></ContextMenu></ListBox.ContextMenu><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="NoWrap" /></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="暂无日志输出" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DisplayedLogLines.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Grid Grid.Row="2" Margin="15,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="CommandInputTextBox" Height="36" Padding="10,8" Tag="向运行中的命令发送输入" IsEnabled="{Binding SelectedCommand.IsRunning, FallbackValue=False, TargetNullValue=False}" KeyDown="CommandInputTextBox_KeyDown" /><Button Grid.Column="1" Style="{StaticResource ActionChip}" Margin="8,0,0,0" ToolTip="发送输入" IsEnabled="{Binding SelectedCommand.IsRunning, FallbackValue=False, TargetNullValue=False}" Click="SendCommandInput_Click"><mi:MaterialIcon Kind="Send" Width="16" Height="16" /></Button></Grid></Grid></Border>
                        </Grid>
                    </Grid>
                </Grid>
                <Border x:Name="NotesPage" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource InputBrush}" Padding="0"><ContentControl x:Name="PluginContentHost" /></Border>
                <Border x:Name="WslPage" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource InputBrush}" Padding="0"><ContentControl x:Name="WslContentHost" /></Border>
                <Border x:Name="PluginManagementPage" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource InputBrush}" Padding="28"><StackPanel><TextBlock Text="插件管理" Style="{StaticResource PageTitle}" /><TextBlock Text="选择要在侧栏启用的插件" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,22" /><Border Style="{StaticResource CardBorder}" Padding="18" Background="{DynamicResource SidebarBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="{DynamicResource SelectedBrush}" CornerRadius="12"><mi:MaterialIcon Kind="NoteTextOutline" Width="21" Height="21" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center"><TextBlock Text="备忘录" /><TextBlock Text="全局 Markdown 笔记" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" /></StackPanel><ToggleButton x:Name="EnableNotesToggle" Grid.Column="2" Style="{StaticResource PluginSwitch}" IsChecked="{Binding EnableNotes, Mode=OneWay}" Click="EnableNotesToggle_Click" ToolTip="启用或关闭备忘录" /></Grid></Border><Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,10,0,0" Background="{DynamicResource SidebarBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="{DynamicResource SelectedBrush}" CornerRadius="12"><mi:MaterialIcon Kind="Linux" Width="21" Height="21" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center"><TextBlock Text="WSL" /><TextBlock Text="查看发行版并运行 WSL 命令" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" /></StackPanel><ToggleButton x:Name="EnableWslToggle" Grid.Column="2" Style="{StaticResource PluginSwitch}" IsChecked="{Binding EnableWsl, Mode=OneWay}" Click="EnableWslToggle_Click" ToolTip="启用或关闭 WSL 插件" /></Grid></Border></StackPanel></Border>
            </Grid>

            <Grid x:Name="StatusBar" Grid.Row="2" Margin="17,0" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel><TextBlock Text="{Binding RunningCount, Mode=OneWay, StringFormat= · {0} 个命令运行中}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
        </Grid>
    </Border>
</Window>
