<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>XProj</AssemblyName>
    <RootNamespace>ProjectManager.Wpf</RootNamespace>
    <AssemblyTitle>XProj</AssemblyTitle>
    <Description>XProj desktop workspace</Description>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.0.2</Version>
    <Product>XProj</Product>
    <Authors>hzlo</Authors>
  </PropertyGroup>

<ItemGroup>
        <ProjectReference Include="..\XProj.Plugin.Abstractions\XProj.Plugin.Abstractions.csproj" />
        <ProjectReference Include="..\XProj.Plugin.DataSync\XProj.Plugin.DataSync.csproj" />
        <ProjectReference Include="..\XProj.Plugin.JsonConverter\XProj.Plugin.JsonConverter.csproj" />
        <ProjectReference Include="..\XProj.Plugin.Notes\XProj.Plugin.Notes.csproj" />
        <ProjectReference Include="..\XProj.Plugin.Translator\XProj.Plugin.Translator.csproj" />
        <ProjectReference Include="..\XProj.Plugin.Wsl\XProj.Plugin.Wsl.csproj" />
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo_dark.png" />
    <Resource Include="Assets\logo_light.png" />
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Material.Icons.WPF" Version="3.0.2" />
  </ItemGroup>

</Project>
