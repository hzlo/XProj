<Window x:Class="ProjectManager.Wpf.Views.RunPlansDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="运行方案"
        Width="1040"
        Height="740"
        MinWidth="860"
        MinHeight="620"
        WindowStyle="None"
         AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
         Background="{DynamicResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RunPlanListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="11,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunCommandListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="CommandRow_PreviewMouseLeftButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource SoftBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelayInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource LogFontFamily}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="14"
                                    Height="14"
                                    CornerRadius="4"
                                    Background="{DynamicResource PanelSolidBrush}"
                                    BorderBrush="{DynamicResource SoftBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M 3 7 L 6 10 L 11 4"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,10,0">
                <TextBlock Text="运行方案" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsCancel="True">
                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="24,10,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="3,0,0,12">
                            <TextBlock Text="方案" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" ToolTip="新建方案" Click="AddPlan_Click">
                                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerBrush}" ToolTip="删除方案" Click="DeletePlan_Click">
                                    <mi:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="PlansList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding Plans}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RunPlanListItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="PlansList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PlanNameTextBox" Tag="例如：开发订单模块" TextChanged="PlanNameTextBox_TextChanged" />
                            </StackPanel>
                            <CheckBox x:Name="StopOutsideCheckBox"
                                      Grid.Column="1"
                                      Content="启动前停止方案外命令"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,9" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,10,0">
                                <TextBox x:Name="CommandSearchTextBox"
                                         Height="38"
                                         Padding="34,8,12,8"
                                         Tag="搜索项目或命令"
                                         TextChanged="CommandSearchTextBox_TextChanged" />
                                <mi:MaterialIcon Kind="Magnify"
                                                 Width="14"
                                                 Height="14"
                                                 Margin="12,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MutedTextBrush}"
                                                 IsHitTestVisible="False" />
                            </Grid>
                            <ToggleButton x:Name="SelectedOnlyToggle"
                                          Grid.Column="1"
                                          Content="仅看已选"
                                          Margin="0,0,14,0"
                                          Style="{StaticResource FilterToggle}"
                                          Checked="SelectedOnlyToggle_Changed"
                                          Unchecked="SelectedOnlyToggle_Changed" />
                            <TextBlock x:Name="SelectionStatsText"
                                       Grid.Column="2"
                                       MinWidth="104"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="4,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="命令" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,12,0">
                                <Button x:Name="SelectFilteredCommandsButton"
                                        Content="全选当前结果"
                                        Padding="8,3"
                                        MinWidth="86"
                                        ToolTip="仅选择当前搜索和筛选结果中的命令"
                                        Click="SelectAllCommands_Click" />
                                <Button x:Name="ClearFilteredCommandsButton"
                                        Content="全不选当前结果"
                                        Padding="8,3"
                                        MinWidth="98"
                                        ToolTip="仅清空当前搜索和筛选结果中的命令"
                                        Click="ClearAllCommands_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="延迟秒"
                                       Style="{StaticResource SectionLabel}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <ListBox x:Name="CommandsList"
                                     ItemsSource="{Binding CommandChoicesView}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource RunCommandListItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Margin" Value="0,0,0,9" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <StackPanel>
                                                                <Border Background="{DynamicResource InsetPanelBrush}"
                                                                        BorderBrush="{DynamicResource SoftBorderBrush}"
                                                                        BorderThickness="0,0,0,1"
                                                                        CornerRadius="6"
                                                                        Margin="0,0,0,6"
                                                                        Padding="10,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name.ProjectDisplayName}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 条命令}"
                                                                                       Margin="9,0,0,0"
                                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <Button Style="{StaticResource CompactIconButton}"
                                                                                    CommandParameter="{Binding Name}"
                                                                                    ToolTip="选择该项目全部命令"
                                                                                    Click="SelectProjectCommands_Click">
                                                                                <mi:MaterialIcon Kind="CheckboxMultipleMarkedOutline" Width="15" Height="15" />
                                                                            </Button>
                                                                            <Button Style="{StaticResource CompactIconButton}"
                                                                                    CommandParameter="{Binding Name}"
                                                                                    ToolTip="清空该项目全部命令"
                                                                                    Click="ClearProjectCommands_Click">
                                                                                <mi:MaterialIcon Kind="CheckboxMultipleBlankOutline" Width="15" Height="15" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <ItemsPresenter />
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="82" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="选择此命令" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CommandName}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding DelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsSelected}"
                                                     ToolTip="选中命令后可设置 0–300 秒延迟"
                                                     Style="{StaticResource DelayInput}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyCommandResultsText"
                                       Text="没有匹配的命令"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="24,18,24,22">
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" MinWidth="86" IsCancel="True" />
                    <Button Content="保存" MinWidth="92" Click="Save_Click" />
                    <Button Content="保存并启动" MinWidth="116" Click="SaveAndRun_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
