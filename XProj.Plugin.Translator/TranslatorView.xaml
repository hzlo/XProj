<UserControl x:Class="XProj.Plugin.Translator.TranslatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             Background="Transparent"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" Background="{DynamicResource SelectedBrush}" CornerRadius="12">
                    <mi:MaterialIcon Kind="Translate" Width="21" Height="21" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="翻译器" Style="{DynamicResource PageTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="在多个翻译服务之间快速切换，结果不会离开当前工作区" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="ProviderBox" Width="128" Margin="0,0,10,0" ToolTip="翻译服务，可随时切换" SelectionChanged="ProviderBox_SelectionChanged" />
                <Button Style="{StaticResource PrimaryButton}" Click="Translate_Click" ToolTip="翻译（Enter）">
                    <StackPanel Orientation="Horizontal"><mi:MaterialIcon Kind="Translate" Width="16" Height="16" Margin="0,0,7,0" /><TextBlock Text="翻译" Foreground="White" FontWeight="SemiBold" /></StackPanel>
                </Button>
                <Button Style="{DynamicResource ActionChip}" ToolTip="交换语言" Click="SwapLanguages_Click"><mi:MaterialIcon Kind="SwapHorizontal" Width="16" Height="16" /></Button>
                <Button Style="{DynamicResource ActionChip}" ToolTip="翻译设置" Click="Settings_Click"><mi:MaterialIcon Kind="CogOutline" Width="16" Height="16" /></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" MinWidth="300" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="原文" Style="{DynamicResource SectionTitle}" /><ComboBox x:Name="SourceLanguageBox" Width="145" HorizontalAlignment="Right" SelectionChanged="Language_SelectionChanged" /></Grid>
                    <TextBox x:Name="SourceTextBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Tag="输入要翻译的内容...（Enter 翻译，Shift+Enter 换行）" FontSize="14" VerticalContentAlignment="Top" KeyDown="SourceTextBox_KeyDown" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource CardBorder}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="译文" Style="{DynamicResource SectionTitle}" /><ComboBox x:Name="TargetLanguageBox" Width="145" HorizontalAlignment="Right" SelectionChanged="Language_SelectionChanged" /></Grid>
                    <TextBox x:Name="ResultTextBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Tag="翻译结果会显示在这里" FontSize="14" VerticalContentAlignment="Top" />
                </Grid>
            </Border>
            <Border x:Name="BusyOverlay" Grid.ColumnSpan="3" Background="#88101418" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="正在翻译..." FontSize="15" HorizontalAlignment="Center" /><ProgressBar Width="160" Height="4" IsIndeterminate="True" Margin="0,14,0,0" /></StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
