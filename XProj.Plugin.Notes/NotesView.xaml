<UserControl x:Class="XProj.Plugin.Notes.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             Background="Transparent"
             Tag="{DynamicResource PanelBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="PrimaryNoteButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <Border x:Name="SelectionMark"
                                    Width="3"
                                    Margin="0,9,0,9"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="24,20,22,28" />
            <Setter Property="FontFamily" Value="{DynamicResource LogFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="TextBlock.LineHeight" Value="22" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" Background="{DynamicResource SelectedBrush}" CornerRadius="12">
                    <mi:MaterialIcon Kind="NoteTextOutline"
                                     Width="21"
                                     Height="21"
                                     Foreground="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="备忘录" Style="{DynamicResource PageTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="随手记录，自动保存为本地 Markdown"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryNoteButton}" Click="NewNote_Click">
                <StackPanel Orientation="Horizontal">
                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="新建笔记" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2"
                Style="{DynamicResource CardBorder}"
                Padding="0"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="254" MinWidth="224" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" MinWidth="520" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                    <Grid Margin="14,15,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="3,0,3,11">
                            <TextBlock Text="全部笔记" Style="{DynamicResource SectionTitle}" FontWeight="SemiBold" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource InsetPanelBrush}"
                                    CornerRadius="8"
                                    Padding="8,3">
                                <TextBlock x:Name="NotesCountTextBlock"
                                           Text="0 篇"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Height="36">
                            <TextBox x:Name="SearchTextBox"
                                     Height="36"
                                     MinHeight="36"
                                     Padding="33,8,10,8"
                                     Tag="搜索标题"
                                     TextChanged="SearchTextBox_TextChanged" />
                            <mi:MaterialIcon Kind="Magnify"
                                             Width="14"
                                             Height="14"
                                             Margin="11,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource MutedTextBrush}"
                                             IsHitTestVisible="False" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <ListBox x:Name="NotesListBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource NoteListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="NotesListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="13,9,11,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30"
                                                    Height="30"
                                                    Background="{DynamicResource InsetPanelBrush}"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center">
                                                <mi:MaterialIcon Kind="FileDocumentOutline"
                                                                 Width="15"
                                                                 Height="15"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LastEditedText}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="EmptyListPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                <mi:MaterialIcon Kind="TextBoxSearchOutline"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{DynamicResource MutedTextBrush}"
                                                 HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyListTextBlock"
                                           Text="还没有笔记"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,9,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="3,10,3,0">
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource SoftBorderBrush}" />

                <Grid Grid.Column="2">
                    <Grid x:Name="DocumentWorkspace" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Background="{DynamicResource PanelBrush}" Margin="18,0">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                 <StackPanel VerticalAlignment="Center">
                                 <TextBlock x:Name="EditorTitleTextBlock"
                                            Text="未选择笔记"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                 <TextBox x:Name="RenameTextBox"
                                          Visibility="Collapsed"
                                          Height="34"
                                          MinHeight="34"
                                          Padding="9,6"
                                          FontSize="16"
                                          FontWeight="SemiBold"
                                          PreviewKeyDown="RenameTextBox_PreviewKeyDown" />
                                 <TextBlock x:Name="EditorMetaTextBlock"
                                            Foreground="{DynamicResource MutedTextBrush}"
                                            FontSize="11"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource InsetPanelBrush}"
                                    BorderBrush="{DynamicResource SoftBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="9,5"
                                    Margin="12,0,9,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SaveStatusDot"
                                             Width="6"
                                             Height="6"
                                             Fill="{DynamicResource SuccessBrush}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="SaveStatusTextBlock"
                                               Text="已保存"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                             <Button x:Name="RenameNoteButton"
                                     Grid.Column="2"
                                     Style="{DynamicResource ActionChip}"
                                     ToolTip="重命名当前笔记"
                                     IsEnabled="False"
                                     Click="RenameNote_Click">
                                 <mi:MaterialIcon Kind="PencilOutline" Width="16" Height="16" />
                             </Button>
                             <Button x:Name="DeleteNoteButton"
                                     Grid.Column="3"
                                     Style="{DynamicResource ActionChip}"
                                    Foreground="{DynamicResource DangerBrush}"
                                    ToolTip="删除当前笔记"
                                    IsEnabled="False"
                                    Click="DeleteNote_Click">
                                <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" MinWidth="260" />
                            </Grid.ColumnDefinitions>

                            <Grid Background="{DynamicResource InputBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="43" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="18,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <mi:MaterialIcon Kind="PencilOutline"
                                                         Width="14"
                                                         Height="14"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         Margin="0,0,7,0" />
                                        <TextBlock Text="编辑" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock x:Name="EditorCharacterCountTextBlock"
                                               Text="0 字符"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />
                                <TextBox x:Name="EditorTextBox"
                                         Grid.Row="2"
                                         Style="{StaticResource NoteEditor}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         SpellCheck.IsEnabled="False"
                                         TextChanged="EditorTextBox_TextChanged" />
                            </Grid>

                            <Border Grid.Column="1" Background="{DynamicResource SoftBorderBrush}" />

                            <Grid Grid.Column="2" Background="{DynamicResource PanelBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="43" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                                    <mi:MaterialIcon Kind="EyeOutline"
                                                     Width="14"
                                                     Height="14"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Margin="0,0,7,0" />
                                    <TextBlock Text="预览" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Row="1" Background="{DynamicResource SoftBorderBrush}" />
                                <WebBrowser x:Name="PreviewBrowser" Grid.Row="2" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="EmptyStatePanel" Background="{DynamicResource PanelBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                            <Border Width="66"
                                    Height="66"
                                    Background="{DynamicResource SelectedBrush}"
                                    CornerRadius="20"
                                    HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="NotePlusOutline"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyStateTitleTextBlock"
                                       Text="写下第一篇笔记"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,18,0,0" />
                            <TextBlock x:Name="EmptyStateDescriptionTextBlock"
                                       Text=""
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="21"
                                       Margin="0,8,0,18" />
                            <Button Style="{StaticResource PrimaryNoteButton}"
                                    HorizontalAlignment="Center"
                                    Click="NewNote_Click">
                                <StackPanel Orientation="Horizontal">
                                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="新建笔记" Foreground="White" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
